# Copie este arquivo para .env e preencha os valores. O .env nunca vai para o Git.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Endereço do admin do Django (termina com /). Não use admin/.
DJANGO_ADMIN_URL=
# 1 só na publicação com HTTPS: redireciona para HTTPS e liga o HSTS.
DJANGO_HTTPS=0

# PostgreSQL
DB_NOME=unifi_sistema
DB_HOST=localhost
DB_PORTA=5432

# Usuário dono das tabelas: só para migrações e para os testes criarem o banco temporário.
# Em produção, o processo web não recebe estas duas linhas.
DB_DONO_USUARIO=unifi_dono
DB_DONO_SENHA=

# Usuário da aplicação: não é dono, não é superusuário, sem BYPASSRLS.
DB_APP_USUARIO=unifi_app
DB_APP_SENHA=

# Cofre: chave mestra que cifra as chaves da UniFi guardadas no banco.
# Gerada por scripts\gerar_env.py. Se perder, as chaves salvas precisam ser cadastradas de novo.
UNIFI_CHAVE_MESTRA=
# Só durante a troca da chave mestra (scripts\gerar_env.py --trocar-chave-mestra).
UNIFI_CHAVE_MESTRA_ANTERIOR=
